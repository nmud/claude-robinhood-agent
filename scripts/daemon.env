# daemon.env — config for scripts/claude-daemon.sh (sourced; bash syntax).
# Edit on the linux box. All values optional; shown values are the defaults.

# tmux session name (the detached Claude TUI lives here)
SESSION=claude-trader

# repo path on the linux box (defaults to the parent of scripts/)
# WORKDIR=$HOME/tradingstrats

# how Claude launches inside tmux. `--continue` resumes the latest conversation
# in WORKDIR so context survives a reboot; falls back to a fresh session.
# For hands-off AUTO you likely need a permission mode that won't block on a
# prompt — set that via your Claude settings/allowlist per CLAUDE.md AUTO rails.
CLAUDE_CMD="claude --continue || claude"

# market gate (US equities regular session)
MARKET_TZ=America/New_York
MARKET_OPEN=0930
MARKET_CLOSE=1600
HALFDAY_CLOSE=1300

# how often (seconds) the kickoff waiter re-checks for the open while armed
POLL=5

# the prompt sent to begin trading at the open. Make it match your CLAUDE.md modes.
KICKOFF="ADVISE mode. Run one trading pass per CLAUDE.md (regime -> strategy -> risk), then /loop every 5m until I say stop."
